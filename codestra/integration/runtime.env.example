# Klyrow Codestra integration environment template.
# Values are placeholders only. Do not commit live secrets.

CODESTRA_BUSINESS=klyrow-email
CODESTRA_APPLICATION=klyrow.com
CODESTRA_SERVICE=klyrow-gateway
CODESTRA_ENVIRONMENT=staging
CODESTRA_REGION=us
CODESTRA_SERVER=server-a
CODESTRA_DEPLOYMENT=git-sha-placeholder

CODESTRA_API_BASE=https://api.codestra.co
CODESTRA_AUTH_ISSUER=https://auth.codestra.co/realms/codestra
CODESTRA_AUTH_AUDIENCE=middleware-api
CODESTRA_KEYCLOAK_CLIENT_ID=klyrow-backend

KLYROW_SAFE_MODE=true
KLYROW_PRODUCTION_GATE_APPROVED=false
KLYROW_N8N_ORCHESTRATION_ENABLED=false
KLYROW_MIDDLEWARE_CANARY_ENABLED=false
KLYROW_PROVIDER_LIVE_DELIVERY_ENABLED=false
KLYROW_SECURITY_SMTP_ENABLED=false
KLYROW_SECURITY_SMTP_LIVE_ENABLED=false
KLYROW_PUBLIC_SMTP_ENABLED=false
KLYROW_POSTAL_LIVE_CANARY_ENABLED=false
LIVE_EMAIL_DELIVERY=false
EXTERNAL_EMAIL_DELIVERY=false
MARKETING_DELIVERY=false
PRODUCTION_PROVIDER_ROUTING=false

KLYROW_MIDDLEWARE_URL=https://api.codestra.co
KLYROW_OBSERVABILITY_MIDDLEWARE_URL=https://api.codestra.co
KLYROW_OBSERVABILITY_DELIVERY_ENABLED=false
KLYROW_MIDDLEWARE_CLIENT_SECRET_FILE=/run/secrets/klyrow-middleware-client-secret
KLYROW_WEBHOOK_SECRET_FILE=/run/secrets/klyrow-webhook-secret
KLYROW_POSTAL_API_KEY_FILE=/run/secrets/klyrow-postal-api-key
KLYROW_SMTP_TLS_CERT=/run/secrets/klyrow-smtp-tls-cert.pem
KLYROW_SMTP_TLS_KEY=/run/secrets/klyrow-smtp-tls-key.pem

METRICS_ENABLED=false
KLYROW_METRICS_TOKEN_FILE=/run/secrets/klyrow-metrics-token
