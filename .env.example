KLYROW_ENV=production
# Production accepts only immutable, digest-addressed images. Populate these
# from the protected release and the separately approved upstream-image ledger.
KLYROW_GATEWAY_IMAGE=
KLYROW_WEB_IMAGE=
KLYROW_MIGRATE_IMAGE=
KLYROW_POSTAL_PROVISIONER_IMAGE=
KLYROW_POSTGRES_IMAGE=
KLYROW_MARIADB_IMAGE=
KLYROW_MAUTIC_IMAGE=
KLYROW_RABBITMQ_IMAGE=
KLYROW_POSTAL_IMAGE=
KLYROW_PROMETHEUS_IMAGE=
KLYROW_GRAFANA_IMAGE=
KLYROW_NODE_EXPORTER_IMAGE=
KLYROW_PUBLIC_URL=https://app.klyrow.com
KLYROW_API_URL=https://api.klyrow.com
KLYROW_DATABASE_URL=postgresql+psycopg://klyrow_runtime@postgres:5432/klyrow
KLYROW_DATABASE_OWNER_PASSWORD_FILE=/etc/klyrow/secrets/database-owner-password
KLYROW_DATABASE_RUNTIME_PASSWORD_FILE=/etc/klyrow/secrets/database-runtime-password
KLYROW_DATABASE_PASSWORD_FILE=/etc/klyrow/secrets/database-runtime-password
KLYROW_SESSION_SECRET_FILE=/etc/klyrow/secrets/session-secret
# Dedicated result/replay encryption authority; standard secret migration creates
# this file once. Retain previous keys through backup/restore and rewrap windows.
KLYROW_DURABLE_RESULT_KEYRING_FILE=/etc/klyrow/secrets/durable-result-keyring.json
KLYROW_DURABLE_RESULT_LEGACY_READ_ENABLED=true
KLYROW_RESULT_RETENTION_SECONDS=2592000
KLYROW_OIDC_ISSUER=https://auth.codestra.co/realms/codestra
KLYROW_OIDC_CLIENT_ID=klyrow-portal
# Leave blank for the public Authorization Code + PKCE client. Set a root-owned
# file path only when Keycloak is deliberately configured as a confidential BFF.
KLYROW_OIDC_CLIENT_SECRET_FILE=
KLYROW_OIDC_REDIRECT_URI=https://app.klyrow.com/auth/callback
KLYROW_BROWSER_SESSION_TTL_SECONDS=28800
KLYROW_BROWSER_SESSION_IDLE_SECONDS=1800
KLYROW_OIDC_FLOW_TTL_SECONDS=600
# Protected deployment data for the one platform owner. The exact subject and
# mailbox stay out of Git. Email is secondary evidence and never grants access.
KLYROW_PLATFORM_OWNER_ISSUER=https://auth.codestra.co/realms/codestra
KLYROW_PLATFORM_OWNER_SUBJECT=
KLYROW_PLATFORM_OWNER_EMAIL=
KLYROW_PLATFORM_OWNER_STEP_UP_MAX_AGE_SECONDS=300
# AMR evidence is authoritative by default. ACR labels remain ignored until a
# protected realm-flow review records that the configured labels guarantee MFA.
KLYROW_PLATFORM_OWNER_REQUIRED_ACR_VALUES=
KLYROW_PLATFORM_OWNER_ACR_MFA_EVIDENCE_APPROVED=false
# The redirect remains fail-closed until issue #83 browser-binds OIDC state.
KLYROW_PLATFORM_OWNER_STEP_UP_ACR_VALUES=
KLYROW_POSTAL_API_KEY_FILE=/etc/klyrow/secrets/postal-api-key
KLYROW_PROVIDER_CREDENTIAL_KEY_FILE=/etc/klyrow/secrets/provider-credential-key
KLYROW_POSTAL_PROVISIONER_TOKEN_FILE=/etc/klyrow/secrets/postal-provisioner-token
KLYROW_POSTAL_PROVISIONER_URL=http://postal-provisioner:9090
KLYROW_TENANT_POSTAL_PROVISIONING_ENABLED=false
KLYROW_ALLOW_LEGACY_GLOBAL_POSTAL_KEY=false
KLYROW_METRICS_TOKEN_FILE=/etc/klyrow/secrets/metrics-token
KLYROW_SECURITY_PAYLOAD_KEY_FILE=/etc/klyrow/secrets/security-payload-key
KLYROW_SECURITY_PAYLOAD_MAX_AGE_SECONDS=3600
# Postal/bootstrap metadata only. These values never establish platform-owner
# authority; production browser ownership is the exact Keycloak binding above.
KLYROW_ADMIN_EMAIL=admin@klyrow.com
KLYROW_ADMIN_PASSWORD=CHANGE_ME_20_CHARS
KLYROW_MIDDLEWARE_URL=https://middleware-email-events.internal.codestra.agency:18080
# The canonical observability API is separate from the legacy email-event endpoint.
KLYROW_OBSERVABILITY_MIDDLEWARE_URL=https://api.codestra.co
KLYROW_OBSERVABILITY_DELIVERY_ENABLED=false
KLYROW_MIDDLEWARE_CLIENT_SECRET_FILE=/etc/klyrow/secrets/middleware-client-secret
KLYROW_MIDDLEWARE_API_KEY_FILE=/etc/klyrow/secrets/middleware-api-key
KLYROW_WEBHOOK_SECRET_FILE=/etc/klyrow/secrets/webhook-secret
KLYROW_SAFE_MODE=true
LIVE_SMS_DELIVERY=false
LIVE_EMAIL_DELIVERY=false
EXTERNAL_SMS_DELIVERY=false
EXTERNAL_EMAIL_DELIVERY=false
PRODUCTION_PROVIDER_ROUTING=false
MARKETING_DELIVERY=false

# Dedicated Keycloak identity-security stream. Keep both false until the
# SECURITY-only SMTP credential, verified sender, Postal API, tenant policy,
# private STARTTLS path, encrypted-payload key, and staging test evidence have
# been approved.
KLYROW_SECURITY_SMTP_ENABLED=false
KLYROW_SECURITY_SMTP_LIVE_ENABLED=false
KLYROW_SECURITY_SMTP_PRODUCTION_APPROVED=false
KLYROW_SECURITY_SMTP_CANARY_RECIPIENTS=
KLYROW_SECURITY_SMTP_CANARY_MAX_DELIVERIES=1
KLYROW_SECURITY_SMTP_EXPECTED_MODE=disabled
KLYROW_SECURITY_SMTP_TENANT_ID=
KLYROW_SECURITY_SMTP_USERNAME=
KLYROW_SECURITY_SMTP_SENDER=

BEYVRA_EMAIL_TENANT_ID=
BEYVRA_EMAIL_SERVICE_TOKEN_FILE=/run/secrets/beyvra_email_service_token
KLYROW_PRODUCTION_GATE_APPROVED=false
KLYROW_CANARY_ALLOWED_DOMAIN=
KLYROW_CANARY_ALLOWED_SENDER=
KLYROW_CANARY_ALLOWED_RECIPIENT=
KLYROW_CANARY_MAX_DELIVERIES=0
KLYROW_AI_ENABLED=false
KLYROW_POSTAL_API_URL=http://postal-web:5000
KLYROW_POSTAL_API_KEY=CHANGE_AFTER_POSTAL_BOOTSTRAP
KLYROW_POSTAL_SERVER_KEY=CHANGE_AFTER_POSTAL_BOOTSTRAP
KLYROW_POSTAL_WEBHOOK_PUBLIC_KEY=/run/klyrow/postal-webhook-signing-public.pem
KLYROW_POSTAL_TENANT_ID=CHANGE_AFTER_BOOTSTRAP
KLYROW_RATE_PER_MINUTE=60
KLYROW_DAILY_QUOTA=10000
MAUTIC_DB_PASSWORD=CHANGE_ME
MAUTIC_DB_ROOT_PASSWORD=CHANGE_ME
POSTAL_DB_PASSWORD=CHANGE_ME
POSTAL_RABBITMQ_PASSWORD=CHANGE_ME
POSTAL_SECRET_KEY=CHANGE_ME_128_HEX
POSTAL_SIGNING_KEY_PATH=/opt/postal/config/signing.key
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
KLYROW_BACKUP_RECIPIENT_FILE=/etc/klyrow/backup-recipient-public.asc
KLYROW_BACKUP_OFFHOST_BACKEND=mounted
# Backblaze backend requires AWS CLI v2 and root-owned mode-0600 credential files.
KLYROW_BACKUP_B2_CONFIG_DIR=/etc/codestra/backup
KLYROW_BACKUP_B2_PREFIX=codestra/klyrow
KLYROW_BACKUP_OFFHOST_DIR=
KLYROW_BACKUP_OFFHOST_REQUIRED=true
KLYROW_RELEASE_EVIDENCE_DIR=/etc/klyrow/releases/current
KLYROW_CONFIG_CHECKSUM_FILE=/etc/klyrow/releases/current-config.sha256
KLYROW_ROLLBACK_DIGESTS_FILE=/etc/klyrow/releases/rollback-digests.json
