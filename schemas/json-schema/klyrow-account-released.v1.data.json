{
  "$id": "https://schemas.codestra.co/events/klyrow-account-released.v1.data.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "changed_at": {
      "format": "date-time",
      "title": "Changed At",
      "type": "string"
    },
    "reason": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "status": {
      "enum": [
        "HELD",
        "RELEASED"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "reason",
    "changed_at"
  ],
  "title": "AccountStateData",
  "type": "object"
}
