{
	email {$KLYROW_STAGING_ACME_EMAIL}
	admin off
}

{$KLYROW_STAGING_HOST} {
	encode zstd gzip
	request_header -X-Authenticated-Client
	request_header -X-Authenticated-Tenant
	request_header -X-Authenticated-Role
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}

	handle /api/* {
		reverse_proxy gateway:8000
	}
	handle /v1/* {
		reverse_proxy gateway:8000
	}
	handle /auth/* {
		reverse_proxy gateway:8000
	}
	handle {
		reverse_proxy web:8080 {
			header_up Host app.klyrow.com
			header_up X-Forwarded-Host {$KLYROW_STAGING_HOST}
		}
	}
}
