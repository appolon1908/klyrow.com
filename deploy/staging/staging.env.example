# Public edge. DNS must resolve this name to the staging Caddy host.
KLYROW_STAGING_HOST=staging.klyrow.com
KLYROW_STAGING_ACME_EMAIL=appolon1908@gmail.com

# Every deployable image MUST be an immutable registry digest. Tags are rejected.
KLYROW_GATEWAY_IMAGE=ghcr.io/appolon1908-hue/klyrow-gateway@sha256:REPLACE
KLYROW_WEB_IMAGE=ghcr.io/appolon1908-hue/klyrow-web@sha256:REPLACE
KLYROW_MIGRATE_IMAGE=ghcr.io/appolon1908-hue/klyrow-migrate@sha256:REPLACE
KLYROW_SEARCH_IMAGE=getmeili/meilisearch@sha256:REPLACE
KLYROW_CADDY_IMAGE=caddy@sha256:REPLACE
KLYROW_POSTGRES_IMAGE=postgres@sha256:REPLACE
KLYROW_PROMETHEUS_IMAGE=prom/prometheus@sha256:REPLACE
KLYROW_GRAFANA_IMAGE=grafana/grafana@sha256:REPLACE
KLYROW_NODE_EXPORTER_IMAGE=prom/node-exporter@sha256:REPLACE

# Exact external release authorities. Never use a floating branch here.
KLYROW_SOURCE_SHA=REPLACE_WITH_40_HEX_SHA
KLYROW_MIDDLEWARE_SOURCE_SHA=REPLACE_WITH_40_HEX_SHA
KLYROW_ODOO_SOURCE_SHA=REPLACE_WITH_40_HEX_SHA
KLYROW_MIDDLEWARE_MIGRATION=0061
KLYROW_ODOO_ADDON=codestra_observability_integration

# Private service endpoints. Monitoring ports are never published by Compose.
KLYROW_KEYCLOAK_URL=https://auth.codestra.co
KLYROW_KEYCLOAK_REALM=codestra
KLYROW_OIDC_CLIENT_ID=klyrow-staging-portal
KLYROW_OIDC_AUDIENCE=klyrow-api
KLYROW_MIDDLEWARE_URL=https://middleware-staging.internal.codestra.agency
KLYROW_EMAIL_EVENT_URL=https://middleware-email-events-staging.internal.codestra.agency/internal/provider-events/klyrow
KLYROW_ODOO_URL=https://odoo-staging.internal.codestra.agency
KLYROW_OPENBAO_ADDR=https://openbao-staging.internal.codestra.agency

# Root-owned files rendered by the OpenBao bootstrap. Values never belong here.
KLYROW_STAGING_SECRET_DIR=/etc/klyrow/staging/secrets
KLYROW_STAGING_EVIDENCE_DIR=/var/lib/klyrow/staging/evidence

# Certification identities and synthetic data only.
KLYROW_TEST_TENANT_ID=00000000-0000-4000-8000-000000000001
KLYROW_TEST_WORKSPACE_A=00000000-0000-4000-8000-00000000000a
KLYROW_TEST_WORKSPACE_B=00000000-0000-4000-8000-00000000000b
KLYROW_LOAD_VUS=20
KLYROW_LOAD_SECONDS=60
