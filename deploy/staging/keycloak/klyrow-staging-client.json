{
  "realm": "codestra",
  "status": "prepared-not-applied",
  "clients": [
    {
      "clientId": "klyrow-staging-portal",
      "name": "Klyrow isolated staging portal",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "rootUrl": "https://staging.klyrow.com",
      "baseUrl": "https://staging.klyrow.com/",
      "redirectUris": ["https://staging.klyrow.com/auth/callback"],
      "webOrigins": ["https://staging.klyrow.com"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://staging.klyrow.com/logged-out",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-klyrow-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "klyrow-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": ["openid", "profile", "email", "roles", "web-origins"]
    }
  ]
}
