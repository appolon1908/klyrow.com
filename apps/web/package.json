{
  "name": "@klyrow/auth-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:a11y": "vitest run src/__tests__/accessibility.test.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:routes": "vitest run src/__tests__/routeManifest.test.ts"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "vite": "7.3.5",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.1",
    "@testing-library/vue": "8.1.0",
    "@types/node": "24.3.0",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.2",
    "eslint-plugin-vue": "10.11.1",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.3.0",
    "vue-tsc": "3.3.13"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.20": "1.1.20",
      "brace-expansion@>=2.0.0 <2.1.6": "2.1.6"
    }
  }
}
